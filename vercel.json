{
  "services": {
    "frontend": {
      "root": "frontend/",
      "rewrites": [
        { "source": "/((?!assets/).*)", "destination": "/index.html" }
      ]
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": { "maxDuration": 300 }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
