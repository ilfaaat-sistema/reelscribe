# ── Supabase ─────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # зарезервировано, в коде сейчас не используется (клиент создаётся только на anon-ключе, см. app/core/db.py)

# ── Instagram-источники (каскад: Apify-профиль → instaloader → StarAPI → yt-dlp) ──
APIFY_API_TOKEN=                # один токен Apify (совместимость)
APIFY_API_TOKENS=               # несколько токенов через запятую — ротация при исчерпании кредита
APIFY_PROFILE_ACTOR=sones~instagram-posts-scraper-lowcost
APIFY_PROFILE_LIMIT=120         # глубина скрейпа автора: выше=лучше покрытие, дороже
APIFY_PROFILE_INFO_ACTOR=apify~instagram-profile-scraper
APIFY_SINGLE_FALLBACK=false     # платный одиночный Apify-фолбэк (apify~instagram-scraper)
APIFY_TOKEN_COOLDOWN_MIN=180    # на сколько минут "остужать" токен после исчерпания кредита/лимита

RAPIDAPI_KEY=                   # один ключ RapidAPI (совместимость)
RAPIDAPI_KEYS=                  # несколько ключей через запятую — ротация при 429
STARAPI_HOST=starapi1.p.rapidapi.com
STARAPI_KEY_COOLDOWN_MIN=30     # на сколько минут "остужать" RapidAPI-ключ после HTTP 429

INSTAGRAM_COOKIES_FILE=         # путь к cookies.txt для yt-dlp

INSTALOADER_ENABLED=false       # включать, только если подложена сессия (INSTALOADER_SESSION_FILE)
INSTALOADER_SESSION_FILE=       # путь к session-файлу (insta_login), опционально
INSTALOADER_USER=               # имя IG-аккаунта для загрузки сессии, опционально
INSTALOADER_MIN_DELAY_SEC=12.0  # анти-бан: минимальная пауза между профилями, сек
INSTALOADER_MAX_DELAY_SEC=30.0  # анти-бан: максимальная пауза между профилями, сек
INSTALOADER_COOLDOWN_MIN=15     # пауза после rate-limit, минут (в это время instaloader молчит)

# ── ASR (распознавание речи) ────────────────────────────────────────────────
ASR_MODE=auto                   # auto | mlx | cloud | faster-whisper — auto: mlx на Apple Silicon → облачный (нужен OPENAI_API_KEY) → faster-whisper CPU
OPENAI_API_KEY=                 # для облачной транскрипции (whisper-1)
YANDEX_SPEECHKIT_KEY=           # зарезервировано, в коде сейчас не используется
DEEPGRAM_API_KEY=               # зарезервировано, в коде сейчас не используется

# ── Перевод ──────────────────────────────────────────────────────────────
DEEPL_API_KEY=                  # опционально: free tier 500k символов/мес — deepl.com/pro#developer

# ── Прочее ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

KAGGLE_USERNAME=ilfatgilmutdinov
KAGGLE_KEY=                     # из kaggle.json (Legacy API) → kaggle.com/settings/api
KAGGLE_NOTEBOOK_ID=             # напр: ilfatgilmutdinov/notebook008db83901

IMPORT_MAX_LINKS=1000           # кап ссылок за один импорт — защита кошелька (публичный сервис)

AUDIO_TMP_DIR=/tmp/reelscribe_audio
WORKER_CONCURRENCY=2            # историческая переменная, кодом не используется (см. TRANSCRIBE_CONCURRENCY ниже)
FRONTEND_URL=*                  # боевое значение — CORS-домены через запятую (напр. https://reelscribe-app.vercel.app)

# ── Воркер на GitHub Actions (API-сервис на Vercel сам транскрипцию не делает) ──
GITHUB_DISPATCH_TOKEN=          # PAT с правом repository_dispatch — запускает воркер через GitHub Actions; нужен только API-сервису
GITHUB_DISPATCH_REPO=ilfaaat-sistema/reelscribe
GITHUB_DISPATCH_EVENT_TYPE=worker-run
TRANSCRIBE_CONCURRENCY=1        # сколько рилсов распознаётся параллельно: 1 на Mac (8 ГБ), 2 на GitHub Actions раннере
